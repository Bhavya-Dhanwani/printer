PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/printer
CORS_ORIGIN=*

# JWT Authentication
ACCESS_TOKEN_SECRET=super_secret_access_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production

# SMTP / Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="printer <noreply@example.com>"
SEND_MAIL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local Storage Paths
TEMP_STORAGE_PATH=./storage/temp
ORIGINAL_STORAGE_PATH=./storage/original
PROCESSED_STORAGE_PATH=./storage/processed
PRINT_STORAGE_PATH=./storage/print-ready

# System Limits & Retention
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=300
DOCUMENT_RETENTION_MINUTES=60
COMPLETED_JOB_RETENTION_MINUTES=10
MAX_CONCURRENT_CONVERSIONS=2
MAX_CONCURRENT_PRINT_JOBS=3
DOCUMENT_PROCESSING_TIMEOUT_MS=120000

# Printer Agent Settings
PRINTER_AGENT_HEARTBEAT_INTERVAL_MS=20000
PRINTER_AGENT_OFFLINE_THRESHOLD_MS=60000

# External Binaries
SUMATRA_PDF_PATH=
LIBREOFFICE_PATH=